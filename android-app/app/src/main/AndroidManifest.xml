<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:allowBackup="true" android:label="주거 공고 알림" android:theme="@style/Theme.HousingAlerts" android:usesCleartextTraffic="true">
        <activity android:name=".ConditionsActivity" />
        <activity android:name=".AnnouncementDetailActivity" />
        <activity android:name=".AnnouncementListActivity" />
        <activity android:name=".InboxActivity" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".HousingMessagingService" android:exported="false"><intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter></service>
    </application>
</manifest>
